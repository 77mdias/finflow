# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# development | test | production
NODE_ENV=development
LOG_LEVEL=info

# ── Banco (Postgres local via docker compose) ──────
# Aplicação (em produção: endpoint *pooled* do Neon)
DATABASE_URL=postgresql://finflow:finflow@localhost:5432/finflow
# Migrações (em produção: endpoint direto do Neon)
DIRECT_URL=postgresql://finflow:finflow@localhost:5432/finflow
# Banco usado pelos testes de integração (é recriado a cada execução)
TEST_DATABASE_URL=postgresql://finflow:finflow@localhost:5432/finflow_test

# ── Auth (Better Auth) ─────────────────────────────
# gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-32ch
# Login social (opcional: cada botão só aparece com as duas variáveis do provedor).
# Redirect URI a cadastrar em cada provedor: <NEXT_PUBLIC_APP_URL>/api/auth/callback/<google|discord>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── E-mail ─────────────────────────────────────────
# smtp (Mailpit local) | resend | memory (testes)
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="FinFlow <lembretes@mail.finflow.app>"
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ── Segredos internos ──────────────────────────────
CRON_SECRET=change-me-cron-secret
UNSUBSCRIBE_SECRET=change-me-unsubscribe-secret

# ── Rate limit ─────────────────────────────────────
# memory | upstash
RATE_LIMIT_DRIVER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Regras de negócio ──────────────────────────────
# true aplica os limites do plano FREE (RN-21)
LIMITS_ENFORCED=false
# true = só envia lembretes na janela 08–09h local (exige cron horário / plano Pro)
REMINDER_LOCAL_WINDOW=false
